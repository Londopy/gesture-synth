{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Gesture Synth main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "shell:allow-execute",
    "shell:allow-open",
    { "identifier": "shell:allow-execute", "allow": [{ "name": "binaries/ffmpeg", "sidecar": true, "args": true }, { "name": "ffmpeg", "cmd": "ffmpeg", "args": true }] },
    "dialog:default",
    "fs:default",
    "opener:default",
    "deep-link:default"
  ]
}
